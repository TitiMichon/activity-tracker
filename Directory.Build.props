<Project>
  <!--
    Single source of truth for the application version (Semantic Versioning: MAJOR.MINOR.PATCH).
    Bump it with:  ./scripts/bump-version.ps1 -Part patch|minor|major
    Release by pushing a matching tag:  git tag v1.0.0 && git push origin v1.0.0
  -->
  <PropertyGroup>
    <VersionPrefix>1.0.0</VersionPrefix>
    <Product>Activity Tracker</Product>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
    <TreatWarningsAsErrors Condition="'$(Configuration)' == 'Release'">true</TreatWarningsAsErrors>
  </PropertyGroup>
</Project>
