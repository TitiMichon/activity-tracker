<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!-- Native app (.NET MAUI Blazor Hybrid) hosting the shared UI. Android for now; iOS can be added as a target later. -->
  <PropertyGroup>
    <TargetFrameworks>net10.0-android</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>ActivityTracker.Mobile</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultCssItems>false</EnableDefaultCssItems>

    <ApplicationTitle>Activity Tracker</ApplicationTitle>
    <ApplicationId>com.titimichon.activitytracker</ApplicationId>

    <!-- Same version as the web app (Directory.Build.props). Android also needs an increasing integer: 1.2.3 -> 10203. -->
    <ApplicationDisplayVersion>$(VersionPrefix)</ApplicationDisplayVersion>
    <ApplicationVersion>$([MSBuild]::Add($([MSBuild]::Add($([MSBuild]::Multiply($([System.Version]::Parse($(VersionPrefix)).Major), 10000)), $([MSBuild]::Multiply($([System.Version]::Parse($(VersionPrefix)).Minor), 100)))), $([System.Version]::Parse($(VersionPrefix)).Build)))</ApplicationVersion>

    <SupportedOSPlatformVersion>26.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <!-- A single installable file for side-loading (no Play Store bundle). -->
    <AndroidPackageFormat>apk</AndroidPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#4f46e5" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#4f46e5" BaseSize="128,128" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="$(MauiVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ActivityTracker.UI\ActivityTracker.UI.csproj" />
  </ItemGroup>

</Project>
