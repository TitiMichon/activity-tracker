@page "/"
@inherits TrackerComponentBase

<PageTitle>Today · Activity Tracker</PageTitle>

<div class="page-head">
    <div>
        <h1>Today</h1>
        <p class="muted">@Tracker.Today.ToString("dddd d MMMM yyyy")</p>
    </div>
</div>

<div class="today-layout">
    <div class="today-main">
        <DayList />

        @if (Tracker.ActiveActivities.Count == 0)
        {
            <QuickAdd />
        }
        else
        {
            <details class="card more-today" data-testid="more-today">
                <summary>
                    <span>More for today</span>
                    <small>@MoreSummary</small>
                </summary>

                @if (Others.Count > 0)
                {
                    <h2>Log another activity</h2>
                    <QuickAdd Activities="Others" />
                }

                @if (WithGoals.Count > 0)
                {
                    <h2>Objectives</h2>
                    @foreach (var a in WithGoals)
                    {
                        <GoalProgressBar Activity="a" Progress="GoalCalculator.Progress(a, Tracker.Entries, Tracker.Today, Tracker.FirstDayOfWeek)" Today="Tracker.Today" />
                    }
                }

                <h2>Today's log</h2>
                <EntryList Entries="Tracker.EntriesOn(Tracker.Today).Reverse().ToList()" EmptyText="Nothing logged today." />
            </details>
        }
    </div>
</div>

@code {
    private IReadOnlyList<Activity> Others => Tracker.QuickAddActivities().Where(a => !ScheduleCalculator.IsDue(a, Tracker.Today)).ToList();

    private IReadOnlyList<Activity> WithGoals => Tracker.ActiveActivities.Where(a => a.Goal is not null).ToList();

    private string MoreSummary => string.Join(" · ", new[]
    {
        Others.Count > 0 ? "other activities" : null,
        WithGoals.Count > 0 ? "objectives" : null,
        "today's log",
    }.Where(s => s is not null));
}
