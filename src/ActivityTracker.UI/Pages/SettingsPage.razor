@page "/settings"
@inherits TrackerComponentBase
@inject IFileExporter Exporter
@inject ToastService Toasts
@inject ReminderService Reminders

<PageTitle>Settings · Activity Tracker</PageTitle>

<div class="page-head">
    <h1>Settings</h1>
</div>

<section class="card">
    <h2>Calendar</h2>
    <label class="field">
        <span>First day of the week</span>
        <select class="input" value="@Tracker.FirstDayOfWeek" @onchange="OnFirstDayChanged" data-testid="first-day">
            @foreach (var d in Enum.GetValues<DayOfWeek>())
            {
                <option value="@d">@d</option>
            }
        </select>
    </label>
</section>

<section class="card">
    <h2>Reminders</h2>
    <p class="muted">
        Set a reminder time on a planned activity (Activities → edit → Periodicity). If it is not done by then,
        you get a notification. Reminders work while the app is open, in a tab or installed on your device.
    </p>
    @if (ReminderActivities.Count > 0)
    {
        <ul class="planned-list" data-testid="reminder-list">
            @foreach (var a in ReminderActivities)
            {
                <li>
                    <ActivityBadge Icon="@a.Icon" Color="@a.Color" Size="sm" />
                    <a href="activities/@a.Id">@a.Name</a>
                    <span class="muted">@a.ReminderTime!.Value.ToString("HH:mm")</span>
                </li>
            }
        </ul>
    }
    <p data-testid="notification-status">
        @switch (_permission)
        {
            case "granted":
                <text>✅ Notifications are allowed.</text>
                break;
            case "denied":
                <text>🚫 Notifications are blocked. Allow them in your browser's site settings; until then reminders only show inside the app.</text>
                break;
            case "unsupported":
                <text>This browser does not support notifications; reminders only show inside the app.</text>
                break;
            default:
                <button type="button" class="btn primary" data-testid="enable-notifications" @onclick="EnableNotificationsAsync">Allow notifications</button>
                break;
        }
    </p>
</section>

<section class="card">
    <h2>Your data</h2>
    <p class="muted">
        Everything is stored on this device, in your browser. Export a backup regularly, or to move your data to another device.
        You have @Tracker.Activities.Count activities and @Tracker.Entries.Count entries.
    </p>
    <div class="actions left">
        <button type="button" class="btn primary" @onclick="ExportAsync">Export backup (JSON)</button>
        <label class="btn ghost file-btn">
            Import backup…
            <InputFile accept=".json,application/json" OnChange="ImportAsync" data-testid="import-file" />
        </label>
    </div>
    @if (_importError is not null)
    {
        <p class="error" role="alert">@_importError</p>
    }
</section>

<section class="card">
    <h2>Danger zone</h2>
    <p class="muted">Delete all activities and entries from this device.</p>
    <ConfirmButton Text="Delete all data" ConfirmText="Really delete everything?" OnConfirm="ClearAsync" />
</section>

<p class="muted version" data-testid="app-version">Activity Tracker v@(AppInfo.Version)</p>

@code {
    private const long MaxImportBytes = 20 * 1024 * 1024;
    private string? _importError;
    private string? _permission;

    private List<Activity> ReminderActivities =>
        Tracker.ActiveActivities.Where(a => a.ReminderTime is not null).OrderBy(a => a.ReminderTime).ToList();

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        _permission = await Reminders.PermissionAsync();
    }

    private async Task EnableNotificationsAsync() => _permission = await Reminders.RequestPermissionAsync();

    private Task OnFirstDayChanged(ChangeEventArgs e) =>
        Enum.TryParse<DayOfWeek>(e.Value?.ToString(), out var day) ? Tracker.SetFirstDayOfWeekAsync(day) : Task.CompletedTask;

    private async Task ExportAsync() =>
        await Exporter.ExportAsync($"activity-tracker-{Tracker.Today:yyyy-MM-dd}.json", "application/json", Tracker.Export());

    private async Task ImportAsync(InputFileChangeEventArgs e)
    {
        _importError = null;
        try
        {
            using var reader = new StreamReader(e.File.OpenReadStream(MaxImportBytes));
            await Tracker.ImportAsync(await reader.ReadToEndAsync());
            Toasts.Show($"Imported {Tracker.Activities.Count} activities and {Tracker.Entries.Count} entries.");
        }
        catch (Exception ex) when (ex is FormatException or IOException)
        {
            _importError = ex.Message;
        }
    }

    private async Task ClearAsync()
    {
        await Tracker.ClearAsync();
        Toasts.Show("All data deleted.");
    }
}
