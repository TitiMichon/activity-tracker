@inherits TrackerComponentBase
@inject ToastService Toasts

<section class="quick-add" aria-label="Quick add">
    @if (Tracker.ActiveActivities.Count == 0)
    {
        <div class="empty card">
            <p>No activities yet.</p>
            <a class="btn primary" href="activities">Create your first activity</a>
        </div>
    }
    else
    {
        <div class="qa-grid">
            @foreach (var a in Tracker.QuickAddActivities())
            {
                var progress = Tracker.ProgressOn(a, TargetDate);
                <button type="button" class="qa-tile @(_selected?.Id == a.Id ? "selected" : "") @(progress.IsDone ? "done" : progress.Count > 0 ? "partial" : "")"
                        style="--c:@a.Color" data-testid="qa-tile" aria-label="Log @a.Name" @onclick="() => OnTileClickAsync(a)">
                    <ActivityBadge Icon="@a.Icon" Color="@a.Color" Size="lg" />
                    <span class="qa-name">@a.Name</span>
                    <span class="qa-sub">@SubText(a, progress)</span>
                </button>
            }
        </div>

        @if (_selected is { } sel)
        {
            <div class="qa-panel card" style="--c:@sel.Color" data-testid="qa-panel">
                <div class="qa-panel-head">
                    <ActivityBadge Icon="@sel.Icon" Color="@sel.Color" />
                    <strong>@sel.Name</strong>
                    <button type="button" class="icon-btn" aria-label="Close" @onclick="Close"><NavIcon Name="close" /></button>
                </div>

                @if (sel.Kind == ActivityKind.Quantity)
                {
                    <div class="qa-value-row">
                        <button type="button" class="btn round" aria-label="Decrease" @onclick="() => Step(-1)">−</button>
                        <input class="input qa-value" type="number" step="any" min="0" aria-label="Value" @bind="_value" />
                        <span class="qa-unit">@sel.Unit</span>
                        <button type="button" class="btn round" aria-label="Increase" @onclick="() => Step(1)">+</button>
                    </div>
                }
                else if (sel.Kind == ActivityKind.Scale)
                {
                    <div class="option-row" role="group" aria-label="Options">
                        @foreach (var o in sel.Options)
                        {
                            <button type="button" class="option-btn" style="--c:@o.Color" aria-label="@o.Label" @onclick="() => LogOptionAsync(o)">
                                <span class="option-icon">@o.Icon</span>
                                <span>@o.Label</span>
                            </button>
                        }
                    </div>
                }

                <input class="input" placeholder="Note (optional)" aria-label="Note" @bind="_note" />

                <div class="actions">
                    <button type="button" class="btn ghost" @onclick="OpenDetails">More options…</button>
                    @if (sel.Kind == ActivityKind.Quantity)
                    {
                        <button type="button" class="btn primary" data-testid="qa-add" @onclick="LogQuantityAsync">Add</button>
                    }
                </div>
            </div>
        }
    }
</section>

@if (_details is not null)
{
    <EntryEditor Entry="_details" IsNew="true" OnClose="() => _details = null" />
}

@code {
    private Activity? _selected;
    private double? _value;
    private string? _note;
    private Entry? _details;

    /// <summary>Day to log on. Defaults to today; past/future days keep the current time of day.</summary>
    [Parameter] public DateOnly? Date { get; set; }

    private DateOnly TargetDate => Date ?? Tracker.Today;

    private string DayWord => TargetDate == Tracker.Today ? "today" : "this day";

    private DateTime? Timestamp => TargetDate == Tracker.Today ? null : TargetDate.ToDateTime(TimeOnly.FromDateTime(Tracker.Now));

    private string SubText(Activity a, DayProgress progress) =>
        progress.Required > 1 ? $"{progress.Count} / {progress.Required} {DayWord}"
        : progress.Count > 0 ? $"{progress.Count}× {DayWord}"
        : Hint(a);

    private static string Hint(Activity a) => a.Kind switch
    {
        ActivityKind.Quantity => a.DefaultValue is { } v ? $"+{v:0.##} {a.Unit}".TrimEnd() : $"Add {a.Unit}".TrimEnd(),
        ActivityKind.Scale => "Pick one",
        _ => "Tap to log",
    };

    private async Task OnTileClickAsync(Activity a)
    {
        if (a.Kind == ActivityKind.Check)
        {
            _selected = null;
            var entry = await Tracker.LogAsync(a.Id, at: Timestamp);
            Notify(a, entry);
            return;
        }

        if (_selected?.Id == a.Id)
        {
            Close();
            return;
        }

        _selected = a;
        _value = a.DefaultValue ?? Tracker.LastValue(a.Id) ?? 1;
        _note = null;
    }

    private void Step(int direction)
    {
        var step = (_selected?.DefaultValue is > 0 and < 5) ? 1 : 5;
        _value = Math.Max(0, (_value ?? 0) + (direction * step));
    }

    private async Task LogQuantityAsync()
    {
        if (_selected is not { } a)
        {
            return;
        }

        var entry = await Tracker.LogAsync(a.Id, _value, at: Timestamp, note: _note);
        Close();
        Notify(a, entry);
    }

    private async Task LogOptionAsync(ActivityOption option)
    {
        if (_selected is not { } a)
        {
            return;
        }

        var entry = await Tracker.LogAsync(a.Id, optionId: option.Id, at: Timestamp, note: _note);
        Close();
        Notify(a, entry);
    }

    private void OpenDetails()
    {
        if (_selected is not { } a)
        {
            return;
        }

        _details = new Entry
        {
            ActivityId = a.Id,
            Timestamp = Timestamp ?? Tracker.Now,
            Value = a.Kind == ActivityKind.Quantity ? _value : null,
            OptionId = a.Kind == ActivityKind.Scale ? a.Options.FirstOrDefault()?.Id : null,
            Note = _note,
        };
        Close();
    }

    private void Notify(Activity a, Entry entry) =>
        Toasts.Show($"{a.Icon} {a.Name}: {EntryAppearance.ValueText(a, entry)}", "Undo", () => Tracker.DeleteEntryAsync(entry.Id));

    private void Close() => _selected = null;
}
