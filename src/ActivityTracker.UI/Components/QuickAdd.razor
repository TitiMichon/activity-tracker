@inherits TrackerComponentBase
@inject ToastService Toasts

<section class="quick-add" aria-label="Quick add">
    @if (Tracker.ActiveActivities.Count == 0)
    {
        <div class="empty card">
            <p>No activities yet.</p>
            <a class="btn primary" href="activities">Create your first activity</a>
        </div>
    }
    else
    {
        <div class="qa-grid">
            @foreach (var a in Activities ?? Tracker.QuickAddActivities())
            {
                var progress = Tracker.ProgressOn(a, TargetDate);
                <button type="button" class="qa-tile @(_selected?.Id == a.Id ? "selected" : "") @(progress.IsDone ? "done" : progress.Count > 0 ? "partial" : "")"
                        style="--c:@a.Color" data-testid="qa-tile" aria-label="Log @a.Name" @onclick="() => OnTileClickAsync(a)">
                    <ActivityBadge Icon="@a.Icon" Color="@a.Color" Size="lg" />
                    <span class="qa-name">@a.Name</span>
                    <span class="qa-sub">@SubText(a, progress)</span>
                </button>
            }
        </div>

        @if (_selected is { } sel)
        {
            <LogPanel Activity="sel" At="Timestamp" OnClose="Close" />
        }
    }
</section>

@code {
    private Activity? _selected;

    /// <summary>Day to log on. Defaults to today; past/future days keep the current time of day.</summary>
    [Parameter] public DateOnly? Date { get; set; }

    /// <summary>Tiles to show; defaults to every active activity, most recently used first.</summary>
    [Parameter] public IReadOnlyList<Activity>? Activities { get; set; }

    private DateOnly TargetDate => Date ?? Tracker.Today;

    private string DayWord => TargetDate == Tracker.Today ? "today" : "this day";

    private DateTime? Timestamp => TargetDate == Tracker.Today ? null : TargetDate.ToDateTime(TimeOnly.FromDateTime(Tracker.Now));

    private string SubText(Activity a, DayProgress progress) =>
        progress.Required > 1 ? $"{progress.Count} / {progress.Required} {DayWord}"
        : progress.Count > 0 ? $"{progress.Count}× {DayWord}"
        : Hint(a);

    private static string Hint(Activity a) => a.Kind switch
    {
        ActivityKind.Quantity => a.DefaultValue is { } v ? $"+{v:0.##} {a.Unit}".TrimEnd() : $"Add {a.Unit}".TrimEnd(),
        ActivityKind.Scale => "Pick one",
        _ => "Tap to log",
    };

    private async Task OnTileClickAsync(Activity a)
    {
        if (a.Kind == ActivityKind.Check)
        {
            _selected = null;
            var entry = await Tracker.LogAsync(a.Id, at: Timestamp);
            Toasts.Show($"{a.Icon} {a.Name}: {EntryAppearance.ValueText(a, entry)}", "Undo", () => Tracker.DeleteEntryAsync(entry.Id));
            return;
        }

        _selected = _selected?.Id == a.Id ? null : a;
    }

    private void Close() => _selected = null;
}
